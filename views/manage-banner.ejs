<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Festival Special Banner</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --bg-gradient: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%);
      --card-bg: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --focus-ring: rgba(99, 102, 241, 0.25);
      --success: #10b981;
      --danger: #ef4444;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }

    body {
      background: var(--bg-gradient);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px 20px;
    }

    .container {
      width: 100%;
      max-width: 640px;
    }

    .header {
      margin-bottom: 28px;
      text-align: center;
    }

    .header h1 {
      font-size: 26px;
      font-weight: 700;
      color: var(--text-main);
      letter-spacing: -0.5px;
      margin-bottom: 6px;
    }

    .header p {
      font-size: 14px;
      color: var(--text-muted);
    }

    .card {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 32px;
      box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.05), 0 4px 12px -2px rgba(0, 0, 0, 0.02);
      border: 1px solid var(--border-color);
    }

    .form-group {
      margin-bottom: 22px;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: #334155;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    input[type="text"],
    textarea,
    select {
      width: 100%;
      padding: 12px 16px;
      border-radius: 10px;
      border: 1px solid var(--border-color);
      background: #f8fafc;
      font-size: 15px;
      color: var(--text-main);
      transition: all 0.2s ease;
      outline: none;
    }

    input[type="text"]:focus,
    textarea:focus,
    select:focus {
      background: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 0 0 4px var(--focus-ring);
    }

    textarea {
      height: 90px;
      resize: vertical;
    }

    .file-upload-box {
      border: 2px dashed #cbd5e1;
      padding: 20px;
      border-radius: 12px;
      background: #f8fafc;
      text-align: center;
      cursor: pointer;
      transition: border-color 0.2s ease;
    }

    .file-upload-box:hover {
      border-color: var(--primary);
    }

    .file-upload-box input[type="file"] {
      display: block;
      width: 100%;
      font-size: 13px;
      color: var(--text-muted);
      cursor: pointer;
    }

    .image-preview {
      margin-top: 10px;
      font-size: 13px;
      color: var(--primary);
      font-weight: 500;
      word-break: break-all;
    }

    .checkbox-card {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 18px;
      background: #f8fafc;
      border-radius: 12px;
      border: 1px solid var(--border-color);
      margin-bottom: 24px;
    }

    .checkbox-card label {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-main);
      cursor: pointer;
      margin-bottom: 0;
      text-transform: none;
    }

    .checkbox-card input[type="checkbox"] {
      width: 20px;
      height: 20px;
      accent-color: var(--primary);
      cursor: pointer;
    }

    .btn-submit {
      width: 100%;
      background: var(--primary);
      color: #ffffff;
      padding: 14px 24px;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
      transition: all 0.2s ease;
    }

    .btn-submit:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(99, 102, 241, 0.35);
    }

    .btn-submit:disabled {
      opacity: 0.65;
      cursor: not-allowed;
      transform: none;
    }

    /* Floating Toast Notification */
    .toast {
      position: fixed;
      top: 24px;
      right: 24px;
      padding: 16px 22px;
      border-radius: 12px;
      background: #ffffff;
      color: var(--text-main);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12), 0 4px 12px rgba(0, 0, 0, 0.05);
      border-left: 5px solid var(--success);
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 14px;
      font-weight: 600;
      opacity: 0;
      transform: translateY(-20px) scale(0.95);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
      z-index: 1000;
    }

    .toast.show {
      opacity: 1;
      transform: translateY(0) scale(1);
      pointer-events: auto;
    }

    .toast.danger {
      border-left-color: var(--danger);
    }

    .toast-icon {
      font-size: 18px;
    }
  </style>
</head>
<body>

  <!-- Floating Toast Notification -->
  <div id="toast" class="toast <%= (typeof success !== 'undefined' && success) ? 'show' : '' %>">
    <span id="toastIcon" class="toast-icon">✅</span>
    <span id="toastMessage">Banner configuration saved successfully!</span>
  </div>

  <div class="container">
    <div class="header">
      <h1>Festival Special Banner</h1>
      <p>Configure the active promotional banner shown in Explore Themes</p>
    </div>

    <div class="card">
      <form id="bannerForm" action="/api/themes/banner/update" method="POST" enctype="multipart/form-data">
        
        <div class="form-group">
          <label>Target Theme *</label>
          <select name="target_theme_id" id="themeSelect">
            <option value="">-- Select Theme to Link --</option>
            <% themes.forEach(theme => { %>
              <option 
                value="<%= theme._id %>" 
                data-label="<%= theme.label %>"
                <%= (banner && banner.target_theme_id && (banner.target_theme_id._id || banner.target_theme_id).toString() === theme._id.toString()) ? 'selected' : '' %>
              >
                <%= theme.label %> (<%= theme.category_id ? theme.category_id.name : 'No Category' %>)
              </option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label>Badge Label *</label>
          <input type="text" id="inputLabel" name="label" value="<%= banner ? banner.label : '✦ LIMITED EDITION' %>" required />
        </div>

        <div class="form-group">
          <label>Banner Title *</label>
          <input type="text" id="inputTitle" name="title" value="<%= banner ? banner.title : 'Festival Special' %>" required />
        </div>

        <div class="form-group">
          <label>Banner Description *</label>
          <textarea id="inputDescription" name="description" required><%= banner ? banner.description : 'Stunning festive memories with our AI-powered theme collection.' %></textarea>
        </div>

        <div class="form-group">
          <label>CTA Button Text *</label>
          <input type="text" id="inputCtaText" name="cta_text" value="<%= banner ? banner.cta_text : 'Try Now →' %>" required />
        </div>

        <div class="form-group">
          <label>Custom Banner Image (Optional)</label>
          <div class="file-upload-box">
            <input type="file" name="image" accept=".jpg,.jpeg,.png,.webp" />
          </div>
          <div id="imagePreview" class="image-preview">
            <% if (banner && banner.image_url) { %>
              Active Image URL: <%= banner.image_url.substring(0, 55) %>...
            <% } %>
          </div>
        </div>

        <div class="checkbox-card">
          <label for="is_active">Show Banner in App (Active)</label>
          <input type="checkbox" id="is_active" name="is_active" value="true" <%= (!banner || banner.is_active) ? 'checked' : '' %> />
        </div>

        <button type="submit" id="btnSubmit" class="btn-submit">Save Banner Configuration</button>

      </form>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const urlParams = new URLSearchParams(window.location.search);
      if (urlParams.get('success') === 'true') {
        setTimeout(function() {
          alert('Banner configuration saved successfully!');
        }, 300);
        setTimeout(function() {
          const toast = document.getElementById('toast');
          if (toast) toast.classList.remove('show');
        }, 5000);
      }
    });
  </script>

</body>
</html>

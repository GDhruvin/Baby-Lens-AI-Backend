<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BabyLens — Admin Portal Login</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <style>
    :root {
      --primary: #F27B50;
      --primary-dark: #D45A2F;
      --bg-dark: #12141A;
      --card-bg: rgba(26, 30, 41, 0.85);
      --border-color: rgba(255, 255, 255, 0.1);
      --text-muted: #8E9BAE;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--bg-dark);
      background-image: 
        radial-gradient(circle at 15% 20%, rgba(242, 123, 80, 0.12) 0%, transparent 40%),
        radial-gradient(circle at 85% 80%, rgba(100, 110, 255, 0.08) 0%, transparent 45%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      color: #fff;
    }

    .login-container {
      width: 100%;
      max-width: 440px;
    }

    .login-card {
      background: var(--card-bg);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-color);
      border-radius: 28px;
      padding: 40px 36px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
      animation: cardEnter 0.5s ease-out;
    }

    @keyframes cardEnter {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .brand-icon {
      width: 60px;
      height: 60px;
      border-radius: 18px;
      background: linear-gradient(135deg, #F27B50 0%, #D45A2F 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      margin: 0 auto 20px auto;
      box-shadow: 0 10px 24px rgba(242, 123, 80, 0.35);
    }

    .brand-title {
      font-family: 'Outfit', sans-serif;
      font-weight: 800;
      font-size: 26px;
      letter-spacing: -0.5px;
      text-align: center;
      margin-bottom: 6px;
    }

    .brand-subtitle {
      color: var(--text-muted);
      font-size: 13.5px;
      text-align: center;
      margin-bottom: 30px;
    }

    .form-label {
      font-size: 13px;
      font-weight: 600;
      color: #CBD5E1;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .input-wrapper {
      position: relative;
      margin-bottom: 22px;
    }

    .input-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      font-size: 17px;
      pointer-events: none;
    }

    .form-control {
      background: rgba(15, 18, 26, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 16px;
      padding: 14px 16px 14px 46px;
      font-size: 14.5px;
      color: #fff;
      transition: all 0.25s ease;
    }

    .form-control:focus {
      background: rgba(20, 24, 35, 0.9);
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(242, 123, 80, 0.18);
      color: #fff;
    }

    .form-control::placeholder {
      color: #5A6678;
    }

    .btn-submit {
      background: linear-gradient(135deg, #F27B50 0%, #D45A2F 100%);
      border: none;
      border-radius: 16px;
      padding: 15px;
      font-size: 15px;
      font-weight: 700;
      color: #fff;
      width: 100%;
      box-shadow: 0 10px 24px rgba(242, 123, 80, 0.35);
      transition: all 0.25s ease;
      margin-top: 8px;
    }

    .btn-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(242, 123, 80, 0.45);
      color: #fff;
    }

    .btn-submit:active {
      transform: translateY(0);
    }

    .alert-custom-danger {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #FCA5A5;
      border-radius: 14px;
      padding: 12px 16px;
      font-size: 13.5px;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .footer-note {
      text-align: center;
      font-size: 12px;
      color: #5A6678;
      margin-top: 24px;
    }
  </style>
</head>
<body>

  <div class="login-container">
    <div class="login-card">
      <div class="brand-icon">
        <i class="bi bi-camera-fill"></i>
      </div>
      <h1 class="brand-title">BabyLens Admin</h1>
      <p class="brand-subtitle">Enter your admin credentials to access operations</p>

      <% if (typeof message !== 'undefined' && message) { %>
        <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.35); color: #34d399; padding: 12px 16px; border-radius: 12px; margin-bottom: 20px; font-size: 13.5px; display: flex; align-items: center; gap: 10px;">
          <i class="bi bi-check-circle-fill"></i>
          <span><%= message %></span>
        </div>
      <% } %>

      <% if (error) { %>
        <div class="alert-custom-danger">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/admin/login" method="POST">
        <input type="hidden" name="redirect" value="<%= redirect %>">

        <div class="input-wrapper">
          <label class="form-label" for="username">
            <i class="bi bi-person"></i> Username
          </label>
          <i class="bi bi-person-fill input-icon"></i>
          <input
            type="text"
            id="username"
            name="username"
            class="form-control"
            placeholder="admin"
            required
            autofocus
            autocomplete="username"
          >
        </div>

        <div class="input-wrapper">
          <label class="form-label" for="password">
            <i class="bi bi-lock"></i> Password
          </label>
          <i class="bi bi-key-fill input-icon"></i>
          <input
            type="password"
            id="password"
            name="password"
            class="form-control"
            placeholder="••••••••••••"
            required
            autocomplete="current-password"
          >
        </div>

        <button type="submit" class="btn btn-submit">
          Sign In to Portal <i class="bi bi-arrow-right ms-1"></i>
        </button>
      </form>
    </div>

    <div class="footer-note">
      BabyLens Operations &bull; Confidential &bull; Authorized Personnel Only
    </div>
  </div>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Themes — BabyLens Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #6366f1;
      --primary-hover: #4f46e5;
      --bg-gradient: linear-gradient(135deg, #f8fafc 0%, #edf2f7 100%);
      --card-bg: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --focus-ring: rgba(99, 102, 241, 0.25);
      --success: #10b981;
      --success-bg: #dcfce7;
      --warning: #f59e0b;
      --warning-bg: #fef3c7;
      --danger: #ef4444;
      --danger-bg: #fee2e2;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }

    body {
      background: var(--bg-gradient);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 0 40px 0;
    }

    .container {
      width: 100%;
      max-width: 1100px;
      padding: 0 20px;
    }

    .header {
      margin-bottom: 24px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 16px;
    }

    .header-titles h1 {
      font-size: 26px;
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 4px;
      color: var(--text-main);
    }

    .header-titles p {
      font-size: 14px;
      color: var(--text-muted);
    }

    .btn-create {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      background: var(--primary);
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      border-radius: 12px;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
      transition: all 0.2s ease;
    }

    .btn-create:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
    }

    /* KPI Summary Stats */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .kpi-card {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 20px 24px;
      border: 1px solid var(--border-color);
      box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.03);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .kpi-label {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .kpi-value {
      font-size: 26px;
      font-weight: 800;
      color: var(--text-main);
    }

    .card {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.05);
      border: 1px solid var(--border-color);
    }

    .filter-bar {
      margin-bottom: 20px;
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .search-input {
      flex: 1;
      min-width: 250px;
      padding: 10px 16px;
      border: 1px solid var(--border-color);
      border-radius: 10px;
      font-size: 14px;
      outline: none;
    }

    .search-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--focus-ring);
    }

    .table-container {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }

    th {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--text-muted);
      padding: 12px 16px;
      text-align: left;
      border-bottom: 1px solid var(--border-color);
      background: #f8fafc;
    }

    th:first-child {
      border-top-left-radius: 8px;
    }

    th:last-child {
      border-top-right-radius: 8px;
    }

    td {
      padding: 14px 16px;
      border-bottom: 1px solid #f1f5f9;
      font-size: 14px;
      vertical-align: middle;
    }

    tr:last-child td {
      border-bottom: none;
    }

    tr:hover td {
      background: #fafafa;
    }

    .theme-info {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .theme-thumb {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      object-fit: cover;
      background: #e2e8f0;
      border: 1px solid var(--border-color);
    }

    .theme-name {
      font-weight: 700;
      color: var(--text-main);
      display: block;
      margin-bottom: 3px;
    }

    .theme-desc {
      font-size: 12px;
      color: var(--text-muted);
      max-width: 280px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .category-badge {
      display: inline-block;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 600;
      background: #eef2ff;
      color: #4338ca;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
    }

    .status-pill.published {
      background: var(--success-bg);
      color: #065f46;
    }

    .status-pill.draft {
      background: var(--warning-bg);
      color: #92400e;
    }

    .actions-cell {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .btn-action {
      padding: 7px 12px;
      font-size: 12px;
      font-weight: 700;
      border-radius: 8px;
      border: 1px solid transparent;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .btn-publish {
      background: #10b981;
      color: #fff;
    }

    .btn-publish:hover {
      background: #059669;
    }

    .btn-unpublish {
      background: #f59e0b;
      color: #fff;
    }

    .btn-unpublish:hover {
      background: #d97706;
    }

    .btn-broadcast {
      background: #e0e7ff;
      color: #4338ca;
    }

    .btn-broadcast:hover {
      background: #c7d2fe;
    }

    .btn-delete {
      background: #fee2e2;
      color: #b91c1c;
      border: none;
    }

    .btn-delete:hover {
      background: #fecaca;
    }

    .empty-state {
      text-align: center;
      padding: 48px 16px;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <%- include('partials/admin-navbar', { activeTab: 'manage-themes' }) %>

  <div class="container">
    <div class="header">
      <div class="header-titles">
        <h1>Theme Management & Publishing</h1>
        <p>Test draft themes privately on your phone before publishing live to worldwide users</p>
      </div>
      <a href="/api/themes/create" class="btn-create">
        <span>+</span>
        <span>Create New Theme</span>
      </a>
    </div>

    <!-- KPI Counts -->
    <%
      const totalThemes = themes.length;
      const publishedCount = themes.filter(t => t.status === 'published').length;
      const draftCount = themes.filter(t => t.status === 'draft').length;
    %>
    <div class="kpi-grid">
      <div class="kpi-card">
        <span class="kpi-label">Total Themes</span>
        <span class="kpi-value"><%= totalThemes %></span>
      </div>
      <div class="kpi-card" style="border-left: 4px solid var(--success);">
        <span class="kpi-label">Live / Published</span>
        <span class="kpi-value" style="color: #059669;"><%= publishedCount %></span>
      </div>
      <div class="kpi-card" style="border-left: 4px solid var(--warning);">
        <span class="kpi-label">Draft (Testing Mode)</span>
        <span class="kpi-value" style="color: #d97706;"><%= draftCount %></span>
      </div>
    </div>

    <div class="card">
      <div class="filter-bar">
        <input type="text" id="searchInput" class="search-input" placeholder="Search by theme title or category..." onkeyup="filterThemes()" />
      </div>

      <div class="table-container">
        <table id="themesTable">
          <thead>
            <tr>
              <th>Theme</th>
              <th>Category</th>
              <th>Status</th>
              <th>Generations</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (themes.length === 0) { %>
              <tr>
                <td colspan="5" class="empty-state">No themes found. Click "Create New Theme" to add one!</td>
              </tr>
            <% } %>

            <% themes.forEach(function(theme) { %>
              <tr data-label="<%= theme.label.toLowerCase() %>" data-category="<%= (theme.category_id && theme.category_id.name) ? theme.category_id.name.toLowerCase() : '' %>">
                <td>
                  <div class="theme-info">
                    <% if (theme.image_url) { %>
                      <img src="<%= theme.image_url %>" alt="<%= theme.label %>" class="theme-thumb" />
                    <% } else { %>
                      <div class="theme-thumb" style="display:flex;align-items:center;justify-content:center;font-size:20px;">🎨</div>
                    <% } %>
                    <div>
                      <span class="theme-name"><%= theme.label %></span>
                      <span class="theme-desc"><%= theme.description %></span>
                    </div>
                  </div>
                </td>

                <td>
                  <span class="category-badge">
                    <%= (theme.category_id && theme.category_id.name) ? theme.category_id.name : 'General' %>
                  </span>
                </td>

                <td>
                  <% if (theme.status === 'published') { %>
                    <span class="status-pill published">● Live</span>
                  <% } else { %>
                    <span class="status-pill draft">🧪 Draft (Test)</span>
                  <% } %>
                </td>

                <td style="font-weight: 600; color: #475569;">
                  <%= theme.generation_count || 0 %>
                </td>

                <td>
                  <div class="actions-cell">
                    <form action="/api/themes/<%= theme._id %>/toggle-status" method="POST" style="display:inline;">
                      <% if (theme.status === 'published') { %>
                        <input type="hidden" name="status" value="draft" />
                        <button type="submit" class="btn-action btn-unpublish" title="Make this theme draft (hidden from public)">
                          Unpublish
                        </button>
                      <% } else { %>
                        <input type="hidden" name="status" value="published" />
                        <button type="submit" class="btn-action btn-publish" title="Publish this theme live to all parents">
                          🚀 Publish
                        </button>
                      <% } %>
                    </form>

                    <a href="/api/themes/broadcast?theme_id=<%= theme._id %>" class="btn-action btn-broadcast" title="Broadcast push notification">
                      📢 Broadcast
                    </a>

                    <button type="button" class="btn-action btn-delete" onclick="deleteTheme('<%= theme._id %>', '<%= theme.label %>')" title="Delete Theme">
                      🗑️
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    function filterThemes() {
      const q = document.getElementById('searchInput').value.toLowerCase().trim();
      const rows = document.querySelectorAll('#themesTable tbody tr');
      rows.forEach(row => {
        const label = row.getAttribute('data-label') || '';
        const cat = row.getAttribute('data-category') || '';
        if (label.includes(q) || cat.includes(q)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    async function deleteTheme(id, label) {
      if (!confirm(`Are you sure you want to permanently delete "${label}"? This cannot be undone.`)) {
        return;
      }

      try {
        const response = await fetch(`/api/themes/${id}`, {
          method: 'DELETE',
          headers: { 'Accept': 'application/json' }
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json().catch(() => ({}));
          alert(data.message || 'Failed to delete theme.');
        }
      } catch (err) {
        alert('Network error while deleting theme: ' + err.message);
      }
    }
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Themes — BabyLens Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #D05A2A;
      --primary-hover: #b04318;
      --primary-light: #fef0eb;
      --bg: #FAF6F2;
      --card-bg: #ffffff;
      --text-main: #2D1C12;
      --text-muted: #7C6A5D;
      --border: #EAE0D6;
      --border-light: #F4EBE3;
      --success: #10B981;
      --success-bg: #ECFDF5;
      --warning: #D97706;
      --warning-bg: #FFFBEB;
      --danger: #EF4444;
      --danger-bg: #FEF2F2;
      --shadow-sm: 0 2px 8px rgba(45, 28, 18, 0.04);
      --shadow-md: 0 8px 24px -4px rgba(45, 28, 18, 0.08);
      --radius: 16px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
    }

    html, body {
      min-height: 100%;
      width: 100%;
      background: var(--bg);
      color: var(--text-main);
      overflow-x: hidden;
      overflow-y: auto;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      width: 100%;
      max-width: 1380px;
      margin: 0 auto;
      padding: 24px 24px 80px 24px;
    }

    .header-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 24px;
    }

    .header-titles h1 {
      font-size: 26px;
      font-weight: 800;
      color: var(--text-main);
      letter-spacing: -0.5px;
      margin-bottom: 4px;
    }

    .header-titles p {
      font-size: 14px;
      color: var(--text-muted);
    }

    .btn-create {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 22px;
      background: var(--primary);
      color: #ffffff;
      font-size: 14px;
      font-weight: 700;
      border-radius: 12px;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(208, 90, 42, 0.35);
      transition: all 0.2s ease;
    }

    .btn-create:hover {
      background: var(--primary-hover);
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(208, 90, 42, 0.45);
    }

    /* KPI Cards */
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }

    .kpi-card {
      background: var(--card-bg);
      border-radius: var(--radius);
      padding: 20px 24px;
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .kpi-details {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .kpi-label {
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.8px;
    }

    .kpi-value {
      font-size: 30px;
      font-weight: 800;
      color: var(--text-main);
      line-height: 1.1;
    }

    .kpi-icon-wrap {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .kpi-icon-wrap.total {
      background: var(--primary-light);
      color: var(--primary);
    }

    .kpi-icon-wrap.live {
      background: var(--success-bg);
      color: var(--success);
    }

    .kpi-icon-wrap.draft {
      background: var(--warning-bg);
      color: var(--warning);
    }

    /* Table Container & Filter */
    .table-card {
      background: var(--card-bg);
      border-radius: var(--radius);
      box-shadow: var(--shadow-sm);
      border: 1px solid var(--border);
      overflow: hidden;
    }

    .filter-bar {
      padding: 16px 24px;
      border-bottom: 1px solid var(--border-light);
      display: flex;
      gap: 16px;
      align-items: center;
      flex-wrap: wrap;
      background: #FFFFFF;
    }

    .search-wrapper {
      position: relative;
      flex: 1;
      min-width: 280px;
    }

    .search-icon {
      position: absolute;
      left: 14px;
      top: 50%;
      transform: translateY(-50%);
      width: 18px;
      height: 18px;
      color: var(--text-muted);
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      padding: 10px 14px 10px 42px;
      border: 1px solid var(--border);
      border-radius: 10px;
      font-size: 14px;
      color: var(--text-main);
      background: #FAFAFA;
      outline: none;
      transition: all 0.2s ease;
    }

    .search-input:focus {
      background: #FFFFFF;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(208, 90, 42, 0.15);
    }

    /* Fixed Header & Scrollable Body */
    .table-scroll {
      width: 100%;
      max-height: 520px;
      overflow-y: auto;
      overflow-x: auto;
      position: relative;
    }

    table {
      width: 100%;
      min-width: 960px;
      border-collapse: collapse;
      text-align: left;
    }

    thead th {
      position: sticky;
      top: 0;
      z-index: 10;
      padding: 14px 20px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      color: var(--text-muted);
      background: #FAF7F4;
      box-shadow: inset 0 -1px 0 var(--border);
      white-space: nowrap;
    }

    tbody tr {
      border-bottom: 1px solid var(--border-light);
      transition: background 0.15s ease;
    }

    tbody tr:last-child {
      border-bottom: none;
    }

    tbody tr:hover {
      background: #FCFAF8;
    }

    tbody td {
      padding: 14px 20px;
      vertical-align: middle;
      font-size: 14px;
    }

    /* Theme Thumbnail & Details */
    .theme-col {
      display: flex;
      align-items: center;
      gap: 16px;
      max-width: 440px;
    }

    .theme-thumb-box {
      width: 52px;
      height: 52px;
      border-radius: 12px;
      overflow: hidden;
      flex-shrink: 0;
      background: #F3ECE6;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }

    .theme-thumb-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .theme-meta {
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 0;
    }

    .theme-title {
      font-weight: 700;
      font-size: 15px;
      color: var(--text-main);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .theme-desc {
      font-size: 12px;
      color: var(--text-muted);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .category-badge {
      display: inline-flex;
      align-items: center;
      padding: 5px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      background: #F4EBE3;
      color: #694330;
      white-space: nowrap;
    }

    /* Status Pills */
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .status-pill.published {
      background: var(--success-bg);
      color: #065F46;
      border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .status-pill.draft {
      background: var(--warning-bg);
      color: #92400E;
      border: 1px solid rgba(217, 119, 6, 0.25);
    }

    .status-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
    }

    .status-pill.published .status-dot {
      background: var(--success);
      box-shadow: 0 0 6px var(--success);
    }

    .status-pill.draft .status-dot {
      background: var(--warning);
      box-shadow: 0 0 6px var(--warning);
    }

    .generations-count {
      font-size: 14px;
      font-weight: 800;
      color: var(--text-main);
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* Action Buttons */
    .actions-group {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: nowrap;
    }

    .btn-action {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 12px;
      border-radius: 9px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      border: 1px solid transparent;
      white-space: nowrap;
    }

    .btn-publish {
      background: #10B981;
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(16, 185, 129, 0.25);
    }

    .btn-publish:hover {
      background: #059669;
      transform: translateY(-1px);
    }

    .btn-unpublish {
      background: #FFFBEB;
      color: #B45309;
      border-color: #FDE68A;
    }

    .btn-unpublish:hover {
      background: #FEF3C7;
      color: #92400E;
      transform: translateY(-1px);
    }

    .btn-broadcast {
      background: var(--primary-light);
      color: var(--primary);
      border-color: rgba(208, 90, 42, 0.2);
    }

    .btn-broadcast:hover {
      background: #fcdbd0;
      color: var(--primary-hover);
      transform: translateY(-1px);
    }

    .btn-delete {
      background: var(--danger-bg);
      color: var(--danger);
      border-color: rgba(239, 68, 68, 0.2);
    }

    .btn-delete:hover {
      background: #FEE2E2;
      color: #B91C1C;
      transform: translateY(-1px);
    }

    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: var(--text-muted);
    }

    .empty-state i {
      width: 48px;
      height: 48px;
      margin-bottom: 12px;
      opacity: 0.4;
    }

    /* Pagination Bar */
    .pagination-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 24px;
      background: #FAF7F4;
      border-top: 1px solid var(--border);
      flex-wrap: wrap;
      gap: 12px;
    }

    .pagination-info {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-muted);
    }

    .pagination-info strong {
      color: var(--text-main);
    }

    .pagination-controls {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .page-size-select {
      padding: 6px 10px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-main);
      background: #ffffff;
      outline: none;
      cursor: pointer;
    }

    .pagination-btns {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .page-btn {
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: #ffffff;
      color: var(--text-main);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 34px;
      text-decoration: none;
    }

    .page-btn:hover:not(.disabled):not(.active) {
      border-color: var(--primary);
      color: var(--primary);
      background: var(--primary-light);
    }

    .page-btn.active {
      background: var(--primary);
      color: #ffffff;
      border-color: var(--primary);
      box-shadow: 0 2px 8px rgba(208, 90, 42, 0.35);
    }

    .page-btn.disabled {
      opacity: 0.4;
      cursor: not-allowed;
      pointer-events: none;
    }
  </style>
</head>
<body>
  <%- include('partials/admin-navbar', { activeTab: 'manage-themes' }) %>

  <div class="container">
    <div class="header-bar">
      <div class="header-titles">
        <h1>Theme Gallery & Publishing</h1>
        <p>Test draft themes privately on your phone before publishing live worldwide</p>
      </div>
      <a href="/api/themes/create" class="btn-create">
        <i data-lucide="plus" style="width: 16px; height: 16px;"></i>
        <span>Create New Theme</span>
      </a>
    </div>

    <!-- KPI Counts -->
    <%
      const totalThemes = themes.length;
      const publishedCount = themes.filter(t => t.status === 'published').length;
      const draftCount = themes.filter(t => t.status === 'draft').length;
    %>
    <div class="kpi-grid">
      <div class="kpi-card">
        <div class="kpi-details">
          <span class="kpi-label">Total Themes</span>
          <span class="kpi-value"><%= totalThemes %></span>
        </div>
        <div class="kpi-icon-wrap total">
          <i data-lucide="palette" style="width: 24px; height: 24px;"></i>
        </div>
      </div>

      <div class="kpi-card">
        <div class="kpi-details">
          <span class="kpi-label">Live / Published</span>
          <span class="kpi-value" style="color: #059669;"><%= publishedCount %></span>
        </div>
        <div class="kpi-icon-wrap live">
          <i data-lucide="check-circle-2" style="width: 24px; height: 24px;"></i>
        </div>
      </div>

      <div class="kpi-card">
        <div class="kpi-details">
          <span class="kpi-label">Draft (Testing Mode)</span>
          <span class="kpi-value" style="color: #D97706;"><%= draftCount %></span>
        </div>
        <div class="kpi-icon-wrap draft">
          <i data-lucide="flask-conical" style="width: 24px; height: 24px;"></i>
        </div>
      </div>
    </div>

    <!-- Table Card -->
    <div class="table-card">
      <div class="filter-bar">
        <div class="search-wrapper">
          <i data-lucide="search" class="search-icon"></i>
          <input type="text" id="searchInput" class="search-input" placeholder="Search themes by title, category, or description..." oninput="handleSearchChange()" />
        </div>
      </div>

      <!-- Fixed Table Header & Scrollable Body -->
      <div class="table-scroll">
        <table id="themesTable">
          <thead>
            <tr>
              <th style="width: 42%;">Theme</th>
              <th style="width: 15%;">Category</th>
              <th style="width: 13%;">Status</th>
              <th style="width: 10%;">Photoshoots</th>
              <th style="width: 20%; text-align: right; padding-right: 28px;">Actions</th>
            </tr>
          </thead>
          <tbody id="themesTableBody">
            <% if (themes.length === 0) { %>
              <tr id="emptyRow">
                <td colspan="5" class="empty-state">
                  <i data-lucide="image-off"></i>
                  <p style="font-size: 15px; font-weight: 600;">No themes created yet.</p>
                  <p style="font-size: 13px; margin-top: 4px;">Click "Create New Theme" above to add your first photoshoot theme.</p>
                </td>
              </tr>
            <% } %>

            <% themes.forEach(function(theme) { %>
              <tr class="theme-row" data-label="<%= theme.label.toLowerCase() %>" data-category="<%= (theme.category_id && theme.category_id.name) ? theme.category_id.name.toLowerCase() : '' %>" data-desc="<%= (theme.description || '').toLowerCase() %>">
                <td>
                  <div class="theme-col">
                    <div class="theme-thumb-box">
                      <% if (theme.image_url) { %>
                        <img 
                          src="<%= theme.image_url %>" 
                          alt="<%= theme.label %>" 
                          class="theme-thumb-img" 
                          loading="lazy"
                          onerror="this.onerror=null; this.parentElement.innerHTML='<i data-lucide=\'image\' style=\'width:22px;height:22px;color:#a8978b;\'></i>'; if(window.lucide) window.lucide.createIcons();"
                        />
                      <% } else { %>
                        <i data-lucide="image" style="width: 22px; height: 22px; color: #a8978b;"></i>
                      <% } %>
                    </div>
                    <div class="theme-meta">
                      <span class="theme-title"><%= theme.label %></span>
                      <span class="theme-desc"><%= theme.description %></span>
                    </div>
                  </div>
                </td>

                <td>
                  <span class="category-badge">
                    <%= (theme.category_id && theme.category_id.name) ? theme.category_id.name : 'General' %>
                  </span>
                </td>

                <td>
                  <% if (theme.status === 'published') { %>
                    <span class="status-pill published">
                      <span class="status-dot"></span>
                      <span>Live</span>
                    </span>
                  <% } else { %>
                    <span class="status-pill draft">
                      <span class="status-dot"></span>
                      <span>Draft</span>
                    </span>
                  <% } %>
                </td>

                <td>
                  <span class="generations-count">
                    <i data-lucide="sparkle" style="width: 14px; height: 14px; color: #D05A2A;"></i>
                    <%= theme.generation_count || 0 %>
                  </span>
                </td>

                <td style="text-align: right; padding-right: 28px;">
                  <div class="actions-group" style="justify-content: flex-end;">
                    <form action="/api/themes/<%= theme._id %>/toggle-status" method="POST" style="display:inline;">
                      <% if (theme.status === 'published') { %>
                        <input type="hidden" name="status" value="draft" />
                        <button type="submit" class="btn-action btn-unpublish" title="Move to Draft (Hide from public users)">
                          <i data-lucide="pause-circle" style="width: 13px; height: 13px;"></i>
                          <span>Unpublish</span>
                        </button>
                      <% } else { %>
                        <input type="hidden" name="status" value="published" />
                        <button type="submit" class="btn-action btn-publish" title="Publish live to all parents">
                          <i data-lucide="check-circle" style="width: 13px; height: 13px;"></i>
                          <span>Publish</span>
                        </button>
                      <% } %>
                    </form>

                    <a href="/api/themes/broadcast?theme_id=<%= theme._id %>" class="btn-action btn-broadcast" title="Broadcast push notification">
                      <i data-lucide="megaphone" style="width: 13px; height: 13px;"></i>
                      <span>Broadcast</span>
                    </a>

                    <button type="button" class="btn-action btn-delete" onclick="deleteTheme('<%= theme._id %>', '<%= theme.label %>')" title="Delete Theme">
                      <i data-lucide="trash-2" style="width: 13px; height: 13px;"></i>
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

      <!-- Pagination Footer Bar -->
      <div class="pagination-bar">
        <div class="pagination-info" id="paginationInfo">
          Showing <strong id="pageStart">1</strong>–<strong id="pageEnd">10</strong> of <strong id="totalItems"><%= themes.length %></strong> themes
        </div>
        <div class="pagination-controls">
          <label for="pageSizeSelect" style="font-size: 13px; color: var(--text-muted); font-weight: 600;">Per page:</label>
          <select id="pageSizeSelect" class="page-size-select" onchange="changePageSize(Number(this.value))">
            <option value="6">6</option>
            <option value="10" selected>10</option>
            <option value="20">20</option>
            <option value="50">50</option>
          </select>
          <div class="pagination-btns" id="paginationBtns">
            <!-- Rendered by JS -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Interactive Pagination & Filter State
    let currentPage = 1;
    let pageSize = 10;
    let filteredRows = [];

    function getAllRows() {
      return Array.from(document.querySelectorAll('.theme-row'));
    }

    function renderPagination() {
      const allRows = getAllRows();
      const q = document.getElementById('searchInput').value.toLowerCase().trim();

      // Filter rows
      filteredRows = allRows.filter(row => {
        const label = row.getAttribute('data-label') || '';
        const cat = row.getAttribute('data-category') || '';
        const desc = row.getAttribute('data-desc') || '';
        return !q || label.includes(q) || cat.includes(q) || desc.includes(q);
      });

      const totalItems = filteredRows.length;
      const totalPages = Math.max(1, Math.ceil(totalItems / pageSize));
      if (currentPage > totalPages) currentPage = totalPages;

      // Hide all rows first
      allRows.forEach(row => {
        row.style.display = 'none';
      });

      // Show current page slice of filtered rows
      const startIndex = (currentPage - 1) * pageSize;
      const endIndex = Math.min(startIndex + pageSize, totalItems);

      for (let i = startIndex; i < endIndex; i++) {
        if (filteredRows[i]) {
          filteredRows[i].style.display = '';
        }
      }

      // Update info text
      const pageStartEl = document.getElementById('pageStart');
      const pageEndEl = document.getElementById('pageEnd');
      const totalItemsEl = document.getElementById('totalItems');

      if (totalItems === 0) {
        pageStartEl.textContent = '0';
        pageEndEl.textContent = '0';
      } else {
        pageStartEl.textContent = String(startIndex + 1);
        pageEndEl.textContent = String(endIndex);
      }
      totalItemsEl.textContent = String(totalItems);

      // Render pagination buttons
      const btnsContainer = document.getElementById('paginationBtns');
      btnsContainer.innerHTML = '';

      // Prev Button
      const prevBtn = document.createElement('button');
      prevBtn.className = 'page-btn' + (currentPage === 1 ? ' disabled' : '');
      prevBtn.innerHTML = '‹';
      prevBtn.title = 'Previous Page';
      prevBtn.onclick = () => { if (currentPage > 1) { currentPage--; renderPagination(); } };
      btnsContainer.appendChild(prevBtn);

      // Page numbers
      for (let p = 1; p <= totalPages; p++) {
        if (totalPages <= 6 || p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) {
          const numBtn = document.createElement('button');
          numBtn.className = 'page-btn' + (p === currentPage ? ' active' : '');
          numBtn.textContent = String(p);
          numBtn.onclick = () => { currentPage = p; renderPagination(); };
          btnsContainer.appendChild(numBtn);
        } else if (p === currentPage - 2 || p === currentPage + 2) {
          const dots = document.createElement('span');
          dots.textContent = '…';
          dots.style.padding = '0 4px';
          dots.style.color = '#7C6A5D';
          btnsContainer.appendChild(dots);
        }
      }

      // Next Button
      const nextBtn = document.createElement('button');
      nextBtn.className = 'page-btn' + (currentPage === totalPages ? ' disabled' : '');
      nextBtn.innerHTML = '›';
      nextBtn.title = 'Next Page';
      nextBtn.onclick = () => { if (currentPage < totalPages) { currentPage++; renderPagination(); } };
      btnsContainer.appendChild(nextBtn);
    }

    function handleSearchChange() {
      currentPage = 1;
      renderPagination();
    }

    function changePageSize(newSize) {
      pageSize = newSize;
      currentPage = 1;
      renderPagination();
    }

    async function deleteTheme(id, label) {
      if (!confirm(`Are you sure you want to permanently delete "${label}"? This action cannot be undone.`)) {
        return;
      }

      try {
        const response = await fetch(`/api/themes/${id}`, {
          method: 'DELETE',
          headers: { 'Accept': 'application/json' }
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const data = await response.json().catch(() => ({}));
          alert(data.message || 'Failed to delete theme.');
        }
      } catch (err) {
        alert('Network error while deleting theme: ' + err.message);
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      if (window.lucide) {
        window.lucide.createIcons();
      }
      renderPagination();
    });
  </script>
</body>
</html>

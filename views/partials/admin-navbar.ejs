<!-- Lucide Icons Library -->
<script src="https://unpkg.com/lucide@latest"></script>

<!-- Admin Global Top Navigation Bar -->
<div class="admin-topbar-wrapper">
  <header class="admin-topbar">
    <div class="admin-topbar-container">
      <!-- Brand Logo -->
      <a href="/api/payments/transactions" class="admin-topbar-brand">
        <div class="brand-badge">
          <i data-lucide="sparkles" style="width: 20px; height: 20px; color: #ffffff;"></i>
        </div>
        <div class="brand-text">
          <span class="brand-title">BabyLens</span>
          <span class="brand-sub">Studio Portal</span>
        </div>
      </a>

      <!-- Navigation Links -->
      <nav class="admin-topbar-nav">
        <a href="/api/payments/transactions" 
           class="topbar-link <%= (typeof activeTab !== 'undefined' && activeTab === 'transactions') ? 'active' : '' %>">
          <i data-lucide="receipt" class="nav-icon"></i>
          <span>Transactions</span>
        </a>
        <a href="/api/themes/create" 
           class="topbar-link <%= (typeof activeTab !== 'undefined' && activeTab === 'create-theme') ? 'active' : '' %>">
          <i data-lucide="plus-circle" class="nav-icon"></i>
          <span>Create Theme</span>
        </a>
        <a href="/api/themes/manage" 
           class="topbar-link <%= (typeof activeTab !== 'undefined' && activeTab === 'manage-themes') ? 'active' : '' %>">
          <i data-lucide="layout-grid" class="nav-icon"></i>
          <span>Manage Themes</span>
        </a>
        <a href="/api/themes/banner/manage" 
           class="topbar-link <%= (typeof activeTab !== 'undefined' && activeTab === 'banner') ? 'active' : '' %>">
          <i data-lucide="flag" class="nav-icon"></i>
          <span>Festival Banner</span>
        </a>
        <a href="/api/themes/broadcast" 
           class="topbar-link <%= (typeof activeTab !== 'undefined' && activeTab === 'broadcast') ? 'active' : '' %>">
          <i data-lucide="megaphone" class="nav-icon"></i>
          <span>Broadcast</span>
        </a>
      </nav>

      <!-- User / Logout Action -->
      <div class="admin-topbar-actions">
        <span class="admin-status-pill">
          <span class="status-indicator"></span>
          <span>Studio Active</span>
        </span>
        <a href="/admin/logout" class="topbar-logout-btn" title="Sign out of Admin Session">
          <i data-lucide="log-out" style="width: 14px; height: 14px;"></i>
          <span>Logout</span>
        </a>
      </div>
    </div>
  </header>
</div>
<!-- Fixed Spacer to prevent content jump -->
<div class="admin-topbar-spacer"></div>

<style>
  :root {
    --brand-primary: #D05A2A;
    --brand-primary-hover: #b04318;
    --brand-primary-light: #fef0eb;
    --brand-dark: #1F1610;
    --brand-bg: #FAF6F2;
    --brand-surface: #FFFFFF;
    --brand-border: #EAE0D6;
    --brand-text: #2D1C12;
    --brand-muted: #7C6A5D;
  }

  .admin-topbar-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 1000;
  }

  .admin-topbar-spacer {
    height: 68px;
    width: 100%;
  }

  .admin-topbar {
    width: 100%;
    background: #1A1412;
    border-bottom: 1px solid rgba(234, 224, 214, 0.12);
    box-shadow: 0 4px 24px rgba(29, 20, 16, 0.25);
    backdrop-filter: blur(12px);
  }

  .admin-topbar-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .admin-topbar-brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #ffffff;
  }

  .brand-badge {
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(135deg, #D05A2A 0%, #A23908 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(208, 90, 42, 0.45);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-size: 17px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.4px;
    line-height: 1.2;
  }

  .brand-sub {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #e0b4a4;
  }

  .admin-topbar-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .topbar-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #c4b5a5;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-icon {
    width: 15px;
    height: 15px;
    opacity: 0.8;
  }

  .topbar-link:hover {
    background: rgba(208, 90, 42, 0.18);
    color: #ffffff;
    border-color: rgba(208, 90, 42, 0.35);
    transform: translateY(-1px);
  }

  .topbar-link.active {
    background: #D05A2A;
    color: #ffffff;
    border-color: #D05A2A;
    box-shadow: 0 4px 16px rgba(208, 90, 42, 0.4);
  }

  .topbar-link.active .nav-icon {
    opacity: 1;
  }

  .admin-topbar-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .admin-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: #34d399;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.3px;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
  }

  .topbar-logout-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 10px;
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: #f87171;
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    transition: all 0.2s ease;
  }

  .topbar-logout-btn:hover {
    background: #ef4444;
    color: #ffffff;
    border-color: #ef4444;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    transform: translateY(-1px);
  }

  @media (max-width: 900px) {
    .admin-topbar-container {
      padding: 10px 16px;
      justify-content: center;
    }
    .admin-topbar-brand {
      width: 100%;
      justify-content: center;
      margin-bottom: 4px;
    }
    .admin-topbar-nav {
      justify-content: center;
      width: 100%;
    }
    .admin-topbar-actions {
      margin-top: 4px;
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.lucide) {
      window.lucide.createIcons();
    }
  });
</script>
